{
    "name": "@ac/ac-primevue",
    "version": "0.0.17",
    "author": "PrimeTek Informatics",
    "description": "Customized PrimeVue components for use within Amusement Connect organization.",
    "license": "MIT",
    "sideEffects": [
        "*.vue"
    ],
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts",
    "unpkg": "umd/primevue.min.js",
    "jsdelivr": "umd/primevue.min.js",
    "exports": {
        ".": "./src/index.js",
        "./acdateselector": "./src/acdateselector/ACDateSelector.vue",
        "./acdateselector/style": "./src/acdateselector/style/ACDateSelectorStyle.js",
        "./acdrawer": "./src/acdrawer/ACDrawer.vue",
        "./acdrawer/style": "./src/acdrawer/style/ACDrawerStyle.js",
        "./*": "./*"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:package",
        "build:package": "npm run build:prebuild && npx rollup -c && npm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "dev:link": "npm link --global && npm link"
    },
    "devDependencies": {
        "@rollup/plugin-alias": "^5.1.0",
        "@rollup/plugin-babel": "^6.0.3",
        "@rollup/plugin-commonjs": "^28.0.8",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^0.4.4",
        "cross-env": "^10.1.0",
        "rollup": "^4.52.5",
        "rollup-plugin-postcss": "^4.0.0",
        "rollup-plugin-vue": "^6.0.0-beta.9"
    },
    "dependencies": {
        "@ac/acprimeuix-styles": "0.0.2",
        "dayjs": "^1.11.18"
    },
    "peerDependencies": {
        "@primeuix/styled": "^0.7.4",
        "@primeuix/styles": "^1.2.5",
        "@primeuix/utils": "^0.6.1",
        "@primevue/core": "^4.4.1",
        "@primevue/icons": "^4.4.1"
    },
    "engines": {
        "node": ">=12.11.0"
    }
}
