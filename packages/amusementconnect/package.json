{
    "name": "@ac/ac-primevue",
    "version": "0.0.2",
    "author": "PrimeTek Informatics",
    "description": "Customized PrimeVue components for use within Amusement Connect organization.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/primefaces/primevue.git",
        "directory": "packages/primevue"
    },
    "sideEffects": [
        "*.vue"
    ],
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts",
    "unpkg": "umd/primevue.min.js",
    "jsdelivr": "umd/primevue.min.js",
    "web-types": "./web-types.json",
    "exports": {
        "./acdateselector": "./src/acdateselector/ACDateSelector.vue",
        "./acdateselector/style": "./src/acdateselector/style/ACDateSelectorStyle.js",
        "./*": "./*"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && pnpm run build:api && rollup -c && pnpm run build:postbuild",
        "build:api": "node ./scripts/build-api.js",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "dev:link": "pnpm link --global && npm link",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest watch",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.8",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@vue/test-utils": "^2.0.0",
        "vitest": "^0.29.8"
    },
    "dependencies": {
        "@ac/acprimeuix-styles": "0.0.1",
        "dayjs": "^1.11.18"
    },
    "peerDependencies": {
        "@primeuix/styled": "^0.7.4",
        "@primeuix/utils": "^0.6.1",
        "@primeuix/styles": "^1.2.5",
        "@primevue/core": "^4.4.1",
        "@primevue/icons": "^4.4.1"
    },
    "engines": {
        "node": ">=12.11.0"
    },
    "homepage": "https://primevue.org/",
    "bugs": {
        "url": "https://github.com/primefaces/primevue/issues"
    }
}